{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run SessionStart --harness codex", "timeout": 30 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run UserPromptSubmit --harness codex", "timeout": 15 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash|shell|exec_command|local_shell|apply_patch|read_file|write_file|edit_file",
        "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run PreToolUse --harness codex", "timeout": 15 }]
      }
    ],
    "PostToolUse": [
      { "matcher": "Bash|shell", "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run PostToolUse --harness codex", "timeout": 15 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run Stop --harness codex", "timeout": 60 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run PreCompact --harness codex", "timeout": 60 }] }
    ]
  }
}
