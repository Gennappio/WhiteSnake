{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run SessionStart", "timeout": 30 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run UserPromptSubmit", "timeout": 15 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run PreToolUse", "timeout": 15 }]
      }
    ],
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run PostToolUse", "timeout": 15 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run Stop", "timeout": 60 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run PreCompact", "timeout": 60 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "{{WHITESNAKE}} hooks run SessionEnd", "timeout": 60 }] }
    ]
  }
}
