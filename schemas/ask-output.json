{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoSoft store answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "records", "confidence"],
  "properties": {
    "answer": { "type": "string" },
    "records": { "type": "array", "items": { "type": "string" }, "description": "Ids of the records the answer rests on" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
